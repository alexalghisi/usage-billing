{
  "name": "usage-billing",
  "private": true,
  "version": "0.1.0",
  "description": "Usage-based billing for a managed database service: metering, rollups, rating, invoicing, tax and marketplace reporting",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "web"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "sqs": "node scripts/elasticmq.ts",
    "dev": "node src/cli/demo.ts",
    "simulate": "node src/cli/simulate-month.ts",
    "bench": "node bench/run.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1146.0",
    "fastify": "^5.12.5",
    "mongodb": "^7.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^22.20.5",
    "decimal.js": "^10.6.0",
    "fast-check": "^4.10.2",
    "mongodb-memory-server": "^11.3.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  },
  "config": {
    "mongodbMemoryServer": {
      "version": "8.0.4"
    }
  }
}
